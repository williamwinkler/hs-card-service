PORT=8080
CLIENT_ID= <blizzard_client_id>
CLIENT_SECRET= <blizzard_client_secret>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
LOG_LEVEL=debug
BASIC_AUTH_USERNAME=your_username
BASIC_AUTH_PASSWORD=your_secret_password
OTEL_SERVICE_NAME=hscards-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=hearthstone-card-service,deployment.environment=production
